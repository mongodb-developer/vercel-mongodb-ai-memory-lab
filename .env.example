# Copy to .env (next to deno.json) for running the lab on your laptop.
# In the hosted lab these come from /etc/lab-env, which the notebook loads first.

# ── MongoDB ───────────────────────────────────────────────────────────────────
# A local Atlas deployment (`atlas deployments setup --type local`) or any Atlas cluster.
# The memory package creates its collections and Atlas Vector Search indexes itself.
MONGODB_URI="mongodb://localhost:27017/?directConnection=true"

# ── Vercel AI Gateway ─────────────────────────────────────────────────────────
# Chat model and Voyage AI embeddings both go through the Gateway.
# Use a key with paid credits: free-tier keys allow 5 requests/minute per model.
# Create one at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY="<your-ai-gateway-key>"

# Optional: override the chat model (default google/gemini-3.5-flash-lite).
# CHAT_MODEL="openai/gpt-4o-mini"
