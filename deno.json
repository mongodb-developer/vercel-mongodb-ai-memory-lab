{
  "nodeModulesDir": "auto",
  "imports": {
    "ai": "npm:ai@^7.0.0",
    "zod": "npm:zod@^3.25.76",
    "mongodb": "npm:mongodb@^6.0.0",
    "@mongodb-developer/vercel-ai-memory": "npm:@mongodb-developer/vercel-ai-memory@^0.4.2",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.0"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom"]
  },
  "tasks": {
    "kernel": "deno jupyter --install",
    "build": "deno run --allow-read --allow-write scripts/build-notebook.ts",
    "check": "deno check scripts/check.ts scripts/lab.ts",
    "smoke": "deno run --allow-env --allow-net --allow-read --allow-sys scripts/check.ts",
    "lab": "deno run --allow-env --allow-net --allow-read --allow-sys --allow-run scripts/lab.ts",
    "deploy": "bash deploy/deploy.sh"
  }
}

